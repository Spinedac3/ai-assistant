PORT=3000
ASSISTANT_NAME=Asistente
APP_TIMEZONE=UTC

# Own database (docker-compose service `postgres`)
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant

# Keys live in files, never in variables: `pnpm keys:generate` creates this one
JWT_PRIVATE_KEY_FILE=secrets/jwt-private.pem
JWT_ISSUER=ai-assistant
JWT_TTL_SECONDS=900

# Optional: systems allowed to sign logins (JSON with code, algorithm, keyFile, autoProvisionRole)
# EXTERNAL_SYSTEMS_FILE=secrets/external-systems.json

# Document storage (docker-compose service `minio`)
MINIO_ROOT_USER=assistant
MINIO_ROOT_PASSWORD=assistant-secret
