{
  "name": "ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Generic AI assistant: chat, RAG and a declarative SQL tool builder, served over MCP",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spinedac3/ai-assistant.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:integration": "cross-env INTEGRATION_TESTS=true vitest run --no-file-parallelism",
    "test:golden": "cross-env GOLDEN_TESTS=true vitest run tests/golden",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "keys:generate": "tsx src/cli/generateKeys.ts",
    "kek:generate": "tsx src/cli/generateKek.ts",
    "demo:seed": "tsx src/cli/seedDemo.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/createAdmin.ts",
    "docs:load": "tsx --env-file-if-exists=.env src/cli/loadDocuments.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@node-rs/argon2": "^2.2.1",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-es-es": "^4.1.2",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.11.0",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.12",
    "minio": "^8.0.7",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
